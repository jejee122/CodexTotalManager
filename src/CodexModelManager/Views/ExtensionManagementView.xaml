<UserControl x:Class="CodexModelManager.Views.ExtensionManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,26,24,38">
            <Border Background="#7410262E" BorderBrush="#6979DDBA" BorderThickness="1"
                    CornerRadius="12" Padding="20" Margin="0,0,6,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="自定义插件" Foreground="White" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="把一个带 plugin.json 和独立 EXE 的文件夹放进插件目录，刷新后就会出现在这里。"
                                   Foreground="#C5D9D7" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ExtensionRootText" Foreground="#79DDBA" FontFamily="{StaticResource CodeFont}"
                                   FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="插件默认关闭；启用前显示能力和指纹；文件一变，旧授权自动失效。"
                                   Foreground="#E9DFC3" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button Style="{DynamicResource PrimaryButton}" Content="打开插件目录" Padding="14,9"
                                Margin="0,0,0,8" Click="OpenExtensionFolderButton_Click"/>
                        <Button Style="{DynamicResource SecondaryButton}" Content="刷新插件" Padding="14,9"
                                Click="RefreshExtensionsButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Background="#7A3C2E19" BorderBrush="#88D8B76A" BorderThickness="1"
                    CornerRadius="9" Padding="15" Margin="0,0,6,14">
                <TextBlock Text="重要：插件以当前 Windows 账号运行，不是 Windows Sandbox。总管家不会把 Codex、账号池、OAuth 或 API Key 环境变量传给插件，但恶意程序仍可能主动读取你有权限访问的文件或联网。只启用你信任的插件。"
                           Foreground="#F1D7A2" FontSize="12" TextWrapping="Wrap"/>
            </Border>

            <Border x:Name="ExtensionIssuesPanel" Visibility="Collapsed" Background="#6512252D"
                    BorderBrush="#69FF8581" BorderThickness="1" CornerRadius="9" Padding="15" Margin="0,0,6,14">
                <TextBlock x:Name="ExtensionIssuesText" Foreground="#FFB3AF" FontSize="12" TextWrapping="Wrap"/>
            </Border>

            <TextBlock x:Name="ExtensionEmptyText" Text="还没有发现插件。打开插件目录，新建一个插件文件夹后再刷新。"
                       Foreground="{DynamicResource Muted}" FontSize="14" Margin="2,10,0,0" TextWrapping="Wrap"/>

            <ItemsControl x:Name="ExtensionCardsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#6810262E" BorderBrush="#588EAA9F" BorderThickness="1"
                                CornerRadius="11" Padding="18" Margin="0,0,6,12">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" Foreground="White" FontSize="18" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding VersionText}" Foreground="#D7BE7C" FontSize="11"
                                                       Margin="12,5,0,0"/>
                                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontSize="11"
                                                       FontWeight="SemiBold" Margin="12,5,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" Foreground="#C5D9D7" FontSize="12"
                                                   Margin="0,7,0,0" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding PublisherText}" Foreground="#91B8BE" FontSize="11" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                                        <Button Style="{DynamicResource SecondaryButton}" Content="{Binding EnableButtonText}"
                                                Padding="12,8" Margin="0,0,8,0" Tag="{Binding Id}"
                                                Click="ToggleExtensionButton_Click"/>
                                        <Button Style="{DynamicResource PrimaryButton}" Content="{Binding RunButtonText}"
                                                Padding="12,8" IsEnabled="{Binding CanRunOrStop}" Tag="{Binding Id}"
                                                Click="RunExtensionButton_Click"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="插件声明的能力" Foreground="#E9DFC3" FontSize="11"/>
                                        <TextBlock Text="{Binding CapabilitiesText}" Foreground="#B9D2D8" FontSize="12"
                                                   Margin="0,4,16,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="当前文件指纹" Foreground="#E9DFC3" FontSize="11"/>
                                        <TextBlock Text="{Binding FingerprintText}" Foreground="#9DB8C0"
                                                   FontFamily="{StaticResource CodeFont}" FontSize="11" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{Binding TrustWarning}" Foreground="#FFB3AF" FontSize="11"
                                           Margin="0,9,0,0" TextWrapping="Wrap"/>

                                <Expander Header="查看插件输出" Foreground="#9DC2C8" Margin="0,10,0,0">
                                    <TextBox Text="{Binding Output, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                                             Background="#B009181D" Foreground="#D5E6DF" BorderBrush="#5279B6A8"
                                             FontFamily="{StaticResource CodeFont}" FontSize="11" Height="120"
                                             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
