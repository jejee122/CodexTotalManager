<UserControl x:Class="CodexModelManager.Views.PoolManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" FontFamily="{StaticResource AppFont}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style x:Key="PoolButton" TargetType="Button">
            <Setter Property="Foreground" Value="#EAF5F1"/>
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Background" Value="#7A132931"/>
            <Setter Property="BorderBrush" Value="#617C9A94"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#9A19343C"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PoolPrimaryButton" TargetType="Button" BasedOn="{StaticResource PoolButton}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#087E8B"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="PoolDangerButton" TargetType="Button" BasedOn="{StaticResource PoolButton}">
            <Setter Property="Foreground" Value="#FF8581"/>
        </Style>
        <Style x:Key="PoolGhostButton" TargetType="Button" BasedOn="{StaticResource PoolButton}">
            <Setter Property="Foreground" Value="#F6F1DF"/>
            <Setter Property="Background" Value="#160A2228"/>
            <Setter Property="BorderBrush" Value="#5DAEBEB5"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="GhostBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="GhostBorder" Property="Background" Value="#461A4B50"/>
                                <Setter TargetName="GhostBorder" Property="BorderBrush" Value="#B9E9D99E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="GhostBorder" Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LiveTokenFrame" TargetType="Border">
            <Setter Property="Background" Value="#32102027"/>
            <Setter Property="BorderBrush" Value="#55A8C3BD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="18,16"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,26,30,38">
            <Grid MinHeight="210" Margin="0,0,0,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="在同一任务中切换 Pro / Plus，模型名称与聊天上下文保持不变。"
                               Foreground="#E0EBE7" FontSize="15" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,13,0,0">
                        <TextBlock Text="当前线路" Foreground="#8FB0B4" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock x:Name="HeroCurrentAccountText" Text="正在核对…" Foreground="#FFF3D1"
                                   FontSize="16" FontWeight="SemiBold" Margin="12,0,0,0"/>
                        <TextBlock Text="  ·  " Foreground="#6F9398" FontSize="14"/>
                        <TextBlock x:Name="HeroCurrentModelText" Text="gpt-5.6-sol" Foreground="#CDE8E3"
                                   FontSize="15"/>
                        <Ellipse x:Name="LivePulseDot" Width="7" Height="7" Fill="#62E1B5" Margin="14,0,0,0" VerticalAlignment="Center">
                            <Ellipse.Effect><DropShadowEffect Color="#62E1B5" BlurRadius="8" ShadowDepth="0" Opacity="0.9"/></Ellipse.Effect>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.35" To="1" Duration="0:0:1.4"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                        <TextBlock x:Name="HeroTaskStateText" Text="等待本机请求" Foreground="#8FB0B4" FontSize="11"
                                   Margin="7,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,28,0,0" Width="340" HorizontalAlignment="Left">
                    <TextBlock Text="应用所选模型" Style="{StaticResource CloudTitleText}" FontSize="24" Margin="0,0,0,15"/>
                    <Canvas Height="34" VerticalAlignment="Bottom" IsHitTestVisible="False">
                        <Rectangle Width="250" Height="1" Canvas.Top="18" Opacity="0.86">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00F1D99B" Offset="0"/>
                                    <GradientStop Color="#E8F7E9C8" Offset="0.46"/>
                                    <GradientStop Color="#00F1D99B" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                            <Rectangle.Effect><BlurEffect Radius="3"/></Rectangle.Effect>
                        </Rectangle>
                        <Ellipse Width="8" Height="8" Canvas.Top="14" Fill="#FFF1C6">
                            <Ellipse.Effect><BlurEffect Radius="4"/></Ellipse.Effect>
                            <Ellipse.RenderTransform><TranslateTransform x:Name="HeroSparkOne"/></Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="HeroSparkOne" Storyboard.TargetProperty="X" From="6" To="244" Duration="0:0:4.7"/>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" AutoReverse="True" Duration="0:0:2.35"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                    </Canvas>
                </Grid>

                <WrapPanel Grid.Row="2" Margin="0,18,0,0">
                    <Button Style="{StaticResource PoolGhostButton}" Content="刷新实况" Click="RefreshButton_Click"/>
                    <Button Style="{StaticResource PoolPrimaryButton}" Content="回到官方 Pro" Click="ReturnOfficialButton_Click"
                            ToolTip="把默认线路切回官方 Pro；当前任务仍由你在 Codex 自己的模型菜单中选择"/>
                    <Button Style="{StaticResource PoolGhostButton}" Content="添加 Codex 账号" IsEnabled="False"
                            ToolTip="内建原生引擎暂不支持第二个 Codex 账号；未绑定 Plus 保持停用"/>
                    <Button Style="{StaticResource PoolGhostButton}" Content="同步账号" Click="SyncCodexAccountsButton_Click"/>
                    <Button Style="{StaticResource PoolGhostButton}" Content="账号与模型详情" Click="ToggleDetailsButton_Click"/>
                    <Button Style="{StaticResource PoolGhostButton}" Content="Agent API 出口" Click="ToggleGatewayButton_Click"/>
                </WrapPanel>
            </Grid>

            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource LiveTokenFrame}" Margin="0,0,12,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="C O D E X   P R O" Foreground="#C9DAD7" FontSize="10"/>
                            <TextBlock x:Name="ProLiveStateText" Text="读取中" Foreground="#7FADA8" FontSize="10" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock x:Name="ProLiveTotalText" Text="-- Token" Foreground="#FFF1C9" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="24" Margin="0,12,0,0"/>
                        <TextBlock x:Name="ProLiveBreakdownText" Text="今日输入 -- · 输出 --" Foreground="#BDD0D0" FontSize="11" Margin="0,7,0,0"/>
                        <TextBlock x:Name="ProLiveMetaText" Text="等待本机实际请求" Foreground="#78989D" FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource LiveTokenFrame}" Margin="0,0,12,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="C O D E X   P L U S" Foreground="#C9DAD7" FontSize="10"/>
                            <TextBlock x:Name="PlusLiveStateText" Text="读取中" Foreground="#7FADA8" FontSize="10" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock x:Name="PlusLiveTotalText" Text="-- Token" Foreground="#D7FFF0" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="24" Margin="0,12,0,0"/>
                        <TextBlock x:Name="PlusLiveBreakdownText" Text="今日输入 -- · 输出 --" Foreground="#BDD0D0" FontSize="11" Margin="0,7,0,0"/>
                        <TextBlock x:Name="PlusLiveMetaText" Text="等待本机实际请求" Foreground="#78989D" FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock x:Name="LiveUsageSourceText" Text="每 30 秒刷新 · Token 统计与官方额度分开显示"
                       Foreground="#799A9E" FontSize="10" Margin="1,0,0,15"/>

            <Border Style="{StaticResource LiveTokenFrame}" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="逐账号 Token 事实台账" Style="{StaticResource CloudTitleText}" FontSize="19"/>
                    <TextBlock x:Name="AccountLedgerStatusText" Text="正在读取逐 attempt 台账…"
                               Foreground="#8FC8D0" FontSize="11" Margin="0,6,0,10" TextWrapping="Wrap"/>
                    <TextBlock x:Name="AccountLedgerImporterHealthText" Text="归账导入器尚未启动"
                               Foreground="#8FC8D0" FontSize="10" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <TextBlock x:Name="RequestScopeUsageText" Text="请求级未归属用量：暂无"
                               Foreground="#D9C28C" FontSize="10" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <TextBlock x:Name="UnverifiedUsageText" Text="未验证身份用量：暂无"
                               Foreground="#D9C28C" FontSize="10" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <ItemsControl x:Name="AccountLedgerSummaryList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#4A14333A" BorderBrush="#456A7478" BorderThickness="1" CornerRadius="5" Padding="11" Margin="0,0,0,7">
                                    <StackPanel>
                                        <TextBlock Foreground="#FFF1C9" FontSize="13" FontWeight="SemiBold">
                                            <Run Text="{Binding AccountId, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding ProviderId, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Foreground="#B8CFD2" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap">
                                            <Run Text="request "/><Run Text="{Binding RequestCount, Mode=OneWay}"/><Run Text=" · attempt "/><Run Text="{Binding AttemptCount, Mode=OneWay}"/><Run Text=" · 成功 "/><Run Text="{Binding SuccessCount, Mode=OneWay}"/>
                                            <Run Text=" · 失败 "/><Run Text="{Binding FailedCount, Mode=OneWay}"/><Run Text=" · 取消 "/><Run Text="{Binding CancelledCount, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Foreground="#89ADB2" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap">
                                            <Run Text="input "/><Run Text="{Binding Input.DisplayText, Mode=OneWay}"/><Run Text=" · cached "/><Run Text="{Binding CachedInput.DisplayText, Mode=OneWay}"/>
                                            <Run Text=" · cache-read "/><Run Text="{Binding CacheReadInput.DisplayText, Mode=OneWay}"/><Run Text=" · cache-create "/><Run Text="{Binding CacheCreationInput.DisplayText, Mode=OneWay}"/>
                                            <Run Text=" · output "/><Run Text="{Binding Output.DisplayText, Mode=OneWay}"/><Run Text=" · reasoning "/><Run Text="{Binding Reasoning.DisplayText, Mode=OneWay}"/>
                                            <Run Text=" · upstream/derived total "/><Run Text="{Binding Total.DisplayText, Mode=OneWay}"/>
                                            <Run Text=" · mismatch "/><Run Text="{Binding MismatchUsageCount, Mode=OneWay}"/><Run Text=" · invalid "/><Run Text="{Binding InvalidUsageCount, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="最近逐 attempt 明细" Foreground="#C9DAD7" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,6"/>
                    <ItemsControl x:Name="AccountLedgerAttemptList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Foreground="#91B2B6" FontSize="10" Margin="0,0,0,5" TextWrapping="Wrap">
                                    <Run Text="#"/><Run Text="{Binding AttemptOrdinal, Mode=OneWay}"/><Run Text=" · request "/><Run Text="{Binding RequestId, Mode=OneWay}"/>
                                    <Run Text=" · "/><Run Text="{Binding ProviderId, Mode=OneWay}"/><Run Text="/"/><Run Text="{Binding AccountId, Mode=OneWay}"/><Run Text="/"/><Run Text="{Binding Model, Mode=OneWay}"/>
                                    <Run Text=" · "/><Run Text="{Binding Result, Mode=OneWay}"/><Run Text=" · HTTP "/><Run Text="{Binding HttpStatus, Mode=OneWay}"/>
                                    <Run Text=" · total "/><Run Text="{Binding Usage.TotalTokens, Mode=OneWay}"/><Run Text=" ("/><Run Text="{Binding Usage.TotalSource, Mode=OneWay}"/><Run Text=")"/>
                                    <Run Text=" · "/><Run Text="{Binding UsageValidationBadge, Mode=OneWay}"/><Run Text=" · selected "/><Run Text="{Binding Selected, Mode=OneWay}"/>
                                    <Run Text=" · evidence "/><Run Text="{Binding EvidenceStrength, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding ErrorClassification, Mode=OneWay}"/>
                                    <Run Text=" · "/><Run Text="{Binding DisplayTimeText, Mode=OneWay}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Separator Background="#35545B" Margin="0,10"/>
                    <TextBlock Text="独立配额 / 余额快照" Foreground="#C9DAD7" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock x:Name="AccountQuotaStatusText" Text="未提供；不会从 Token 推算"
                               Foreground="#E3BE75" FontSize="10" Margin="0,5,0,7" TextWrapping="Wrap"/>
                    <ItemsControl x:Name="AccountQuotaSnapshotList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Foreground="#89ADB2" FontSize="10" Margin="0,0,0,4" TextWrapping="Wrap">
                                    <Run Text="{Binding Fact.ProviderId, Mode=OneWay}"/><Run Text="/"/><Run Text="{Binding Fact.AccountId, Mode=OneWay}"/><Run Text=" · scope "/><Run Text="{Binding Fact.ObservationScope, Mode=OneWay}"/><Run Text=" · "/>
                                    <Run Text="{Binding Fact.DisplayLabel, Mode=OneWay}"/><Run Text=" ["/><Run Text="{Binding Fact.PeriodKey, Mode=OneWay}"/><Run Text="] = "/><Run Text="{Binding Fact.ValueDisplayText, Mode=OneWay}"/>
                                    <Run Text=" · "/><Run Text="{Binding Fact.ResetDisplayText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Fact.Provenance, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding StateText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding ObservedAtText, Mode=OneWay}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Background="#A60F292E" BorderBrush="#99C99747" BorderThickness="1" CornerRadius="6" Padding="22" Margin="0,0,6,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="我的号池" Style="{StaticResource CloudTitleText}" FontSize="21"/>
                        <TextBlock Text="Pro / Plus 使用官方登录，可在同一任务的下一条消息切换扣费账号；独立 API 出口单独管理。"
                                   Foreground="#B9D2D8" FontSize="13" Margin="0,7,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="额度按账号显示官方剩余比例；Token 和请求数会标明统计范围。没有额度接口的自建 API 只显示本机日志，不冒充官方余额。"
                                   Foreground="#86AFB8" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="StatusMessage" Text="正在读取各号池状态…" Foreground="#8FC8D0" FontSize="12" Margin="0,9,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <WrapPanel Grid.Row="1" HorizontalAlignment="Left" Margin="0,16,0,0">
                        <Button Style="{StaticResource PoolButton}" Content="刷新状态" Click="RefreshButton_Click"/>
                        <Button Style="{StaticResource PoolButton}" Content="添加 Codex 账号" IsEnabled="False"
                                ToolTip="内建原生引擎暂不支持第二个 Codex 账号；未绑定 Plus 保持停用"/>
                        <Button Style="{StaticResource PoolButton}" Content="同步 Codex 账号" Click="SyncCodexAccountsButton_Click"
                                ToolTip="只刷新已有账号的状态、套餐和额度，不新增账号"/>
                        <Button Style="{StaticResource PoolButton}" Content="其他 API 模型" Click="ManageOtherModelsButton_Click"
                                ToolTip="管理不属于号池的兼容 API 模型来源"/>
                    </WrapPanel>
                </Grid>
            </Border>

            <UniformGrid Columns="4" Margin="0,0,6,14">
                <Border Background="#68102229" BorderBrush="#617C9A94" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="首选账号 / 号池" Foreground="#A1BCB8" FontSize="12"/>
                        <TextBlock x:Name="CurrentPoolText" Text="正在读取…" FontSize="17" FontWeight="Bold" Margin="0,7,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="CurrentPoolDetailText" Text="正在核对号池状态" Foreground="#A1BCB8" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Background="#68102229" BorderBrush="#617C9A94" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="首选模型" Foreground="#A1BCB8" FontSize="12"/>
                        <TextBlock x:Name="CurrentPoolModelText" Text="正在读取…" Foreground="#64CBB5" FontSize="17" FontWeight="Bold" Margin="0,7,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="CurrentPoolModelDetailText" Text="来自当前号池，不跨池选择" Foreground="#A1BCB8" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Background="#68102229" BorderBrush="#617C9A94" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Codex 当前任务显示" Foreground="#A1BCB8" FontSize="12"/>
                        <TextBlock x:Name="CurrentTaskModelText" Text="正在读取…" FontSize="17" FontWeight="Bold" Margin="0,7,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="CurrentTaskModelDetailText" Text="正在读取当前任务模型按钮" Foreground="#A1BCB8" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Background="#68102229" BorderBrush="#617C9A94" BorderThickness="1" CornerRadius="8" Padding="16" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="最近实际执行" Foreground="#A1BCB8" FontSize="12"/>
                        <TextBlock x:Name="RecentActualText" Text="正在读取…" Foreground="#64CBB5" FontSize="15"
                                   FontWeight="Bold" Margin="0,7,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="RecentActualDetailText" Text="正在读取 OpenCodex 尝试链" Foreground="#A1BCB8"
                                   FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Visibility="Collapsed" Background="#7810262E" BorderBrush="#617C9A94" BorderThickness="1" CornerRadius="9"
                    Padding="16" Margin="0,0,6,14">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="本机路由审计" FontSize="15" FontWeight="Bold" Foreground="#EAF5F1"/>
                            <TextBlock Text="真实扣费以本机成功请求为准；额度卡片只显示官方汇总值。"
                                       Foreground="#A1BCB8" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#3E173B46" BorderBrush="#617C9A94" BorderThickness="1"
                                CornerRadius="12" Padding="10,4" Margin="16,0,0,0" VerticalAlignment="Top">
                            <TextBlock Text="OpenCodex 日志" Foreground="#7BE0C2" FontSize="10" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                    <UniformGrid Columns="3" Margin="0,12,0,0">
                        <Border Background="#68102229" BorderBrush="#617C9A94" BorderThickness="1" CornerRadius="8"
                                Padding="12" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="本机最后实际扣费账号" Foreground="#A1BCB8" FontSize="11"/>
                                <TextBlock x:Name="RoutingActualAccountText" Text="正在核对…" Foreground="#64CBB5"
                                           FontSize="15" FontWeight="Bold" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#68102229" BorderBrush="#617C9A94" BorderThickness="1" CornerRadius="8"
                                Padding="12" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Pro 最后一次成功请求" Foreground="#A1BCB8" FontSize="11"/>
                                <TextBlock x:Name="RoutingProLastText" Text="正在核对…" Foreground="#EAF5F1"
                                           FontSize="15" FontWeight="Bold" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#68102229" BorderBrush="#617C9A94" BorderThickness="1" CornerRadius="8" Padding="12">
                            <StackPanel>
                                <TextBlock x:Name="RoutingSinceSwitchLabelText" Text="切换当前线路后 Pro 请求"
                                           Foreground="#A1BCB8" FontSize="11"/>
                                <TextBlock x:Name="RoutingProSinceSwitchText" Text="正在核对…" Foreground="#9FC6BC"
                                           FontSize="15" FontWeight="Bold" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <TextBlock x:Name="RoutingAuditSourceText" Text="正在读取本机请求记录…" Foreground="#A1BCB8"
                               FontSize="10" Margin="0,9,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="额度说明：官方汇总值，可能延迟更新。" Foreground="#E3BE75"
                               FontSize="11" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Visibility="Collapsed" Background="#68102229" BorderBrush="#617C9A94" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,6,18">
                <TextBlock Foreground="#9FC6BC" FontSize="13" TextWrapping="Wrap">
                    <Run FontWeight="Bold" Text="运行规则："/>
                    <Run Text="Codex 原生账号切换会把全局线路固定到所选账号，各任务从下一条消息重新绑定，继续显示 Sol / Terra / Luna，聊天和上下文不变；自动切号和故障串池都会关闭。外部 API 使用兼容入口，任何失败都会回滚。"/>
                </TextBlock>
            </Border>

            <Border x:Name="GatewayPanel" Visibility="Collapsed" Background="#7810262E" BorderBrush="#69C99747" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,6,18">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="给 Codex / Agent 使用的统一 API" FontSize="17" FontWeight="Bold" Foreground="#F1F6F2"/>
                            <TextBlock x:Name="GatewayStatusText" Text="正在检查独立 API 出口…" Foreground="#9FC6BC" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#3E173B46" CornerRadius="12" Padding="10,5" Margin="18,0,0,0" VerticalAlignment="Top">
                            <TextBlock x:Name="GatewayBadgeText" Text="检查中" Foreground="#7BE0C2" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#58132931" BorderBrush="#617C9A94" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Base URL（仅本机）" Foreground="#A1BCB8" FontSize="11"/>
                                <TextBlock x:Name="GatewayUrlText" Text="http://127.0.0.1:10110/v1" FontFamily="Consolas" FontSize="13" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#58132931" BorderBrush="#617C9A94" BorderThickness="1" CornerRadius="7" Padding="12" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="API Key（只在复制时读取）" Foreground="#A1BCB8" FontSize="11"/>
                                <TextBlock x:Name="GatewayKeyText" Text="尚未生成" FontFamily="Consolas" FontSize="13" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="GatewayModelsText" Text="正在读取模型目录…" Foreground="#A9C2BF" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="模型名自带号池前缀。请求只按精确名称进入一个上游；同一 Agent 对话切模型时，上下文由 Agent 继续保存。"
                               Foreground="#A1BCB8" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap"/>
                    <WrapPanel Margin="0,14,0,0">
                        <Button Style="{StaticResource PoolPrimaryButton}" Content="启动 / 同步网关" Click="StartGatewayButton_Click"/>
                        <Button Style="{StaticResource PoolButton}" Content="复制 URL" Click="CopyGatewayUrlButton_Click"/>
                        <Button Style="{StaticResource PoolButton}" Content="复制 API Key" Click="CopyGatewayKeyButton_Click"/>
                        <Button x:Name="AuthorizePlusApiButton" Style="{StaticResource PoolButton}" Content="授权 Plus API" Click="AuthorizePlusApiButton_Click"
                                ToolTip="只在 Plus 独立 API 登录缺失时使用；一个 API 池只允许一个账号"/>
                        <Button x:Name="AuthorizeProApiButton" Style="{StaticResource PoolButton}" Content="授权 Pro API" Click="AuthorizeProApiButton_Click"
                                ToolTip="为 Agent 单独建立 Pro API 登录，不会改动 Codex Desktop 的官方 Pro 保底账号"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <ItemsControl x:Name="PoolsList" Visibility="Collapsed">
                <ItemsControl.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <Border Background="#4310262D" BorderBrush="#4FA7BEB8" BorderThickness="1" CornerRadius="3" Padding="14,10" Margin="0,4,6,10">
                                    <TextBlock Text="{Binding Name}" FontFamily="{StaticResource DisplayFont}" FontSize="17" Foreground="#F3E7C8"/>
                                </Border>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ItemsControl.GroupStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="12" Padding="20" Margin="0,0,6,12">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#32102027"/>
                                    <Setter Property="BorderBrush" Value="#4A90AAA7"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="BorderBrush" Value="#B1DCC47D"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                            <Setter Property="Background" Value="#4A102A31"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}" Foreground="#F7F0DC" FontFamily="{StaticResource DisplayFont}" FontSize="20"/>
                                            <Border Background="#4A315C55" BorderBrush="#5E8FD2BE" BorderThickness="1" CornerRadius="13" Padding="10,4" Margin="10,0,0,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="当前线路" Foreground="#9BE0C4" FontWeight="SemiBold" FontSize="12"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding TypeText}" Foreground="#79D3C2" FontWeight="SemiBold" FontSize="12" Margin="0,6,0,0"/>
                                        <TextBlock Text="{Binding Description}" Foreground="#9CB4B7" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusTitle}" Foreground="#E9E4D5" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding LastCheckedText}" Foreground="#78999D" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>

                                <Border Background="#2812262C" BorderBrush="#348FA8A5" BorderThickness="1" CornerRadius="4" Padding="13" Margin="0,14,0,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding StatusDetail}" Foreground="#D4E0DC" FontSize="13" TextWrapping="Wrap"/>
                                        <WrapPanel Margin="0,8,0,0">
                                            <TextBlock Text="{Binding AccountCountText}" Foreground="#7F9FA3" FontSize="12" Margin="0,0,18,0"/>
                                            <TextBlock Text="{Binding ModelCountText}" Foreground="#7F9FA3" FontSize="12" Margin="0,0,18,0"/>
                                            <TextBlock Text="{Binding EndpointText}" Foreground="#7F9FA3" FontSize="12"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <Border Background="#2F2A2926" BorderBrush="#5CAEA16E" BorderThickness="1" CornerRadius="4" Padding="13" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                                            <TextBlock Text="{Binding ModelHeaderText}" Foreground="#F1E5C4" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding ModelActionHint}" Foreground="#829FA1" FontSize="11" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding Models}"
                                                  SelectedItem="{Binding SelectedModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding CanSelectModel}" MinWidth="280" Height="38"
                                                  Padding="10,6" MaxDropDownHeight="320" VerticalContentAlignment="Center"
                                                  ToolTip="{Binding ModelSelectionHint}"/>
                                    </Grid>
                                </Border>

                                <ItemsControl ItemsSource="{Binding Accounts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#3B8FA8A5" BorderThickness="0,1,0,0" Padding="2,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Label}" Foreground="#F0ECDD" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Detail}" Foreground="#8EAAAD" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Status}" Foreground="#7AD6B8" FontSize="12" Margin="0,3,0,0"/>
                                                        <ItemsControl ItemsSource="{Binding QuotaWindows}" Margin="0,10,0,0">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Background="#32142C30" BorderBrush="#4A83A9A1" BorderThickness="1"
                                                                            CornerRadius="7" Padding="10" Margin="0,0,0,7" MaxWidth="620"
                                                                            HorizontalAlignment="Stretch">
                                                                        <Grid>
                                                                            <Grid.RowDefinitions>
                                                                                <RowDefinition Height="Auto"/>
                                                                                <RowDefinition Height="Auto"/>
                                                                                <RowDefinition Height="Auto"/>
                                                                            </Grid.RowDefinitions>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Text="{Binding Label}" Foreground="#E5EBDD" FontWeight="SemiBold" FontSize="12"/>
                                                                            <TextBlock Grid.Column="1" Text="{Binding SummaryText}" Foreground="#A8E1C8"
                                                                                       FontSize="12" FontWeight="SemiBold" Margin="16,0,0,0"/>
                                                                            <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Minimum="0" Maximum="100"
                                                                                         Value="{Binding VisualUsedPercent}" Height="8" Margin="0,7,0,0"
                                                                                         Foreground="#64CBB5" Background="#38142D34"/>
                                                                            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding ResetText}"
                                                                                       Foreground="#829FA3" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <TextBlock Text="{Binding UsageStatisticsText}" Foreground="#A7D5C4" FontSize="12" Margin="0,5,0,0"
                                                                   TextWrapping="Wrap" Visibility="{Binding HasUsageStatistics, Converter={StaticResource BoolToVisibility}}"/>
                                                        <TextBlock Text="{Binding ModelUsageText}" Foreground="#8DA8AC" FontSize="11" Margin="0,5,0,0"
                                                                   TextWrapping="Wrap" Visibility="{Binding HasModelUsage, Converter={StaticResource BoolToVisibility}}"/>
                                                        <Border Background="#40362920" BorderBrush="#7AC9A85B" BorderThickness="1" CornerRadius="4"
                                                                Padding="8,6" Margin="0,7,0,0"
                                                                Visibility="{Binding HasQuotaNote, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBlock Text="{Binding QuotaNote}" Foreground="#D9C28C" FontSize="11" TextWrapping="Wrap"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding UsageSourceText}" Foreground="#718F94" FontSize="10" Margin="0,6,0,0"
                                                                   TextWrapping="Wrap" Visibility="{Binding HasUsageSource, Converter={StaticResource BoolToVisibility}}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                                        <Border Background="#34244035" BorderBrush="#518DB6A5" BorderThickness="1" CornerRadius="4"
                                                                Padding="9,6" Margin="0,0,0,7"
                                                                Visibility="{Binding HasProtection, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBlock Text="{Binding ProtectionText}" Foreground="#9DD6C0" FontSize="11" FontWeight="SemiBold"/>
                                                        </Border>
                                                        <Button Style="{StaticResource PoolGhostButton}" Content="{Binding ToggleActionText}"
                                                                IsEnabled="{Binding ShowRegularAction}" Visibility="{Binding ShowRegularAction, Converter={StaticResource BoolToVisibility}}"
                                                                Click="AccountActionButton_Click" Margin="0"/>
                                                        <Button Style="{StaticResource PoolGhostButton}" Foreground="#F0A5A0" Content="{Binding ToggleActionText}"
                                                                IsEnabled="{Binding ShowDangerAction}" Visibility="{Binding ShowDangerAction, Converter={StaticResource BoolToVisibility}}"
                                                                Click="AccountActionButton_Click" Margin="0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <WrapPanel Margin="0,14,0,0">
                                    <Button Style="{StaticResource PoolPrimaryButton}" Content="{Binding SwitchActionText}" IsEnabled="{Binding CanSwitch}"
                                            Tag="{Binding Id}" Click="SwitchPoolButton_Click"/>
                                    <Button Style="{StaticResource PoolGhostButton}" Content="{Binding AddAccountText}" IsEnabled="{Binding CanAddAccount}"
                                            Visibility="{Binding CanAddAccount, Converter={StaticResource BoolToVisibility}}"
                                            Tag="{Binding Id}" Click="AddAccountButton_Click"/>
                                    <Button Style="{StaticResource PoolGhostButton}" Content="{Binding ConfigureText}" IsEnabled="{Binding CanConfigure}"
                                            Visibility="{Binding CanConfigure, Converter={StaticResource BoolToVisibility}}"
                                            Tag="{Binding Id}" Click="ConfigurePoolButton_Click"/>
                                    <Button Style="{StaticResource PoolGhostButton}" Foreground="#F0A5A0" Content="{Binding TogglePoolText}" IsEnabled="{Binding CanTogglePool}"
                                            Visibility="{Binding CanTogglePool, Converter={StaticResource BoolToVisibility}}"
                                            Tag="{Binding Id}" Click="TogglePoolButton_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
