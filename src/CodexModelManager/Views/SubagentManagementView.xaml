<UserControl x:Class="CodexModelManager.Views.SubagentManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" FontFamily="{StaticResource AppFont}">
    <UserControl.Resources>
        <Style x:Key="AgentCard" TargetType="Border">
            <Setter Property="Background" Value="#6810262E"/>
            <Setter Property="BorderBrush" Value="#588EAA9F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
        <Style x:Key="AgentButton" TargetType="Button">
            <Setter Property="Foreground" Value="#EEF5F1"/>
            <Setter Property="Background" Value="#18343C"/>
            <Setter Property="BorderBrush" Value="#719AB4AE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#27505A"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#A8FFF0"/><Setter TargetName="Frame" Property="BorderThickness" Value="2"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Background" Value="#0F626D"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.42"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AgentPrimaryButton" TargetType="Button" BasedOn="{StaticResource AgentButton}">
            <Setter Property="Background" Value="#087E8B"/>
            <Setter Property="BorderBrush" Value="#69E0D2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,26,30,38">
            <Border Style="{StaticResource AgentCard}" BorderBrush="#78C99747" Padding="22" Margin="0,0,6,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="子代理模型与来源" Style="{StaticResource CloudTitleText}" FontSize="23"/>
                        <TextBlock Text="中转站来源会自动发现，但新来源默认不授权、不加入角色、也不会自动调用；确认来源后再为每个角色选择模型。"
                                   Foreground="#D2E4E0" FontSize="13" Margin="0,7,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="HeroStatusText" Text="正在读取实际配置…" Foreground="#83CFC0"
                                   FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <WrapPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
                        <Border Background="#173B46" CornerRadius="12" Padding="11,5" Margin="0,0,8,8">
                            <TextBlock x:Name="CodexStatusBadge" Text="Codex 检查中" Foreground="#D6ECE7" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                        <Border Background="#3C3023" CornerRadius="12" Padding="11,5" Margin="0,0,0,8">
                            <TextBlock x:Name="ExternalStatusBadge" Text="外部来源检查中" Foreground="#F1D9A8" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </WrapPanel>
                </Grid>
            </Border>

            <Border Background="#4E352615" BorderBrush="#8EC99747" BorderThickness="1" CornerRadius="6"
                    Padding="16,12" Margin="0,0,6,16">
                <TextBlock Foreground="#F2DEB0" FontSize="12" TextWrapping="Wrap">
                    <Run FontWeight="Bold" Text="安全边界："/>
                    <Run Text="自动发现不等于授权。来源授权与角色选择一起安全应用；端点、provider、凭据槽或适配器变化会立即暂停旧授权。外部工人只有纯文本输入输出，没有文件路径、命令或写入工具；原生 Codex 账号只跟随全局线路，不伪装成角色级账号绑定。"/>
                </TextBlock>
            </Border>

            <Grid Margin="0,0,6,11">
                <StackPanel>
                    <TextBlock Text="来源发现与授权" Style="{StaticResource CloudTitleText}" FontSize="20"/>
                    <TextBlock Text="先核对额度、端点和身份，再把来源加入授权草稿。授权本身不会改变任何角色，也不会调用模型。"
                               Foreground="#9FC2C3" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>

            <ItemsControl x:Name="WorkerSourcesList" Margin="0,0,6,10"
                          AutomationProperties.LiveSetting="Polite">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource AgentCard}" Margin="0,0,0,10" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="260"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <WrapPanel>
                                        <TextBlock Text="{Binding DisplayName}" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                        <Border Background="#183A43" CornerRadius="9" Padding="8,3">
                                            <TextBlock Text="{Binding KindText}" Foreground="#A9D7D0" FontSize="11"/>
                                        </Border>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding SourceIdText}" Foreground="#789DA3" FontFamily="{StaticResource CodeFont}" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding EndpointText}" Foreground="#BBD0D0" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding CredentialText}" Foreground="#A9C0C1" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding QuotaText}" Foreground="#D7BE7C" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding CapabilityText}" Foreground="#93B7B7" FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding TrustStatusText}" Foreground="#F1D9A8" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding RuntimeStatusText}" Foreground="#A7D9D1" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding ModelCountText}" Foreground="#8FB2B6" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding IdentityFieldsText}" Foreground="#8FB2B6" FontSize="10" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding FingerprintText}" Foreground="#708F95" FontFamily="{StaticResource CodeFont}" FontSize="10" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding IdentityChangeText}" Foreground="#E2A27D" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                    <Button Style="{StaticResource AgentButton}" Content="{Binding AuthorizationActionText}"
                                            IsEnabled="{Binding CanChangeAuthorization}" Margin="0,12,0,0"
                                            Click="SourceAuthorizationButton_Click"
                                            AutomationProperties.Name="{Binding AuthorizationAutomationName}"
                                            AutomationProperties.HelpText="只修改授权草稿，不会立即调用模型"/>
                                    <TextBlock Text="{Binding UnavailableReason}" Foreground="#D9A67D" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource AgentCard}" BorderBrush="#5677BEB2" Margin="0,0,6,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="桥接生效证据" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock x:Name="BridgeDiskStatusText" Text="磁盘配置：检查中" Foreground="#A7D9D1" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="BridgeHandshakeStatusText" Text="initialize 客户端自报：尚无记录" Foreground="#8FB2B6" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="写入磁盘或收到 initialize 自报，都不等于当前 Codex 任务已加载；Codex 需在新任务或重启后发现该 MCP。" Foreground="#708F95" FontSize="10" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="调用者边界：这是全局 MCP，服务端看不到调用它的模型身份，不能证明调用者一定是 GPT-5.6 Sol；只能通过 Codex 工具审批和角色说明引导。" Foreground="#D7BE7C" FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="最后一次真实路由" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock x:Name="BridgeLastCallText" Text="尚未调用模型" Foreground="#D7BE7C" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="BridgeUsageText" Text="额度路由池：尚未选择 · Token：尚无调用记录" Foreground="#8FB2B6" FontSize="10" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Margin="0,0,6,11">
                <StackPanel>
                    <TextBlock Text="谁负责什么" Style="{StaticResource CloudTitleText}" FontSize="20"/>
                    <TextBlock Text="原生模型由 Codex 子代理启动并跟随当前全局账号；只有已授权且身份未变化的外部来源才会出现在下拉框中。" Foreground="#89AEB3" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ConfigPathText" Foreground="#789DA3" FontFamily="{StaticResource CodeFont}"
                               FontSize="10" Margin="0,7,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>

            <ItemsControl x:Name="SubagentRolesList" Margin="0,0,6,10">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource AgentCard}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="350"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" Foreground="White" FontSize="17" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Purpose}" Foreground="#BBD0D0" FontSize="12" Margin="0,6,0,0"
                                               TextWrapping="Wrap"/>
                                    <WrapPanel Margin="0,11,0,0">
                                        <Border Background="#163A43" CornerRadius="10" Padding="9,4" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding PermissionText}" Foreground="#A9D7D0" FontSize="10"/>
                                        </Border>
                                        <Border Background="#283329" CornerRadius="10" Padding="9,4">
                                            <TextBlock Text="{Binding ReasoningText}" Foreground="#D7DCB9" FontSize="10"/>
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="执行模型" Foreground="#88A8AD" FontSize="10" Margin="1,0,0,5"/>
                                    <ComboBox ItemsSource="{Binding ModelOptions}"
                                              SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayName" SelectionChanged="RoleModelComboBox_SelectionChanged"
                                              AutomationProperties.Name="{Binding ModelAutomationName}"/>
                                    <TextBlock Text="{Binding WorkerKindText}" Foreground="#D7BE7C" FontSize="11" Margin="1,7,0,0"/>
                                    <TextBlock Text="{Binding AppliedStatusText}" Foreground="{Binding AppliedStatusBrush}" FontSize="11"
                                               Margin="1,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource AgentCard}" Margin="0,0,6,14">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="应用前预览" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock x:Name="PlanSummaryText" Text="修改下拉框后可先验证；验证不会写文件。"
                                       Foreground="#B9CFD0" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ProgressBar x:Name="BusyBar" Grid.Column="1" Width="110" Height="5" IsIndeterminate="True"
                                     Visibility="Collapsed" Foreground="#55D5BF" Background="#25434A" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock x:Name="PlanDetailText" Foreground="#82A6AB" FontFamily="{StaticResource CodeFont}"
                               FontSize="10" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    <WrapPanel Margin="0,16,0,0">
                        <Button x:Name="ApplyButton" Style="{StaticResource AgentPrimaryButton}" Content="验证并安全应用到 Codex" Click="ApplyButton_Click"/>
                        <Button x:Name="ValidateButton" Style="{StaticResource AgentButton}" Content="只验证草稿" Click="ValidateButton_Click"/>
                        <Button x:Name="BridgeSelfTestButton" Style="{StaticResource AgentButton}" Content="零额度桥接自检" Click="BridgeSelfTestButton_Click"/>
                        <Button x:Name="LiveWorkerTestButton" Style="{StaticResource AgentButton}" Content="真实调用测试（消耗所选来源额度）" Click="LiveWorkerTestButton_Click"/>
                        <Button x:Name="RefreshButton" Style="{StaticResource AgentButton}" Content="刷新来源（保留草稿）" Click="RefreshButton_Click"/>
                        <Button x:Name="ResetDraftButton" Style="{StaticResource AgentButton}" Content="恢复推荐草稿" Click="ResetDraftButton_Click"/>
                        <Button x:Name="OpenAgentsFolderButton" Style="{StaticResource AgentButton}" Content="打开代理配置目录" Click="OpenAgentsFolderButton_Click"/>
                    </WrapPanel>
                    <TextBlock x:Name="ResultText" Text="尚未写入。" Foreground="#8FB7BC" FontSize="11" Margin="1,6,0,0" TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
