                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="9" Height="9" Fill="{Binding DotColor}" Margin="0,4,9,0" VerticalAlignment="Top"/>
                                                    <TextBlock Text="{Binding Alias}" Foreground="#D7BE7C" FontFamily="{StaticResource CodeFont}" FontSize="13"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding LatencyText}" Foreground="#BBD1D6" FontSize="12"/>
                                            </Grid>
                                            <TextBlock Text="{Binding StatusTitle}" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,9,0,0"/>
                                            <TextBlock Text="{Binding StatusDetail}" Foreground="#9DB8C0" FontSize="12" Margin="0,5,0,12" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding CpuText}" Foreground="White" FontSize="12"/>
                                            <ProgressBar Height="6" Maximum="100" Value="{Binding CpuValue}" Foreground="{Binding CpuColor}" Background="#274753" Margin="0,5,0,10"/>
                                            <TextBlock Text="{Binding MemoryText}" Foreground="White" FontSize="12"/>
                                            <ProgressBar Height="6" Maximum="100" Value="{Binding MemoryValue}" Foreground="{Binding MemoryColor}" Background="#274753" Margin="0,5,0,10"/>
                                            <TextBlock Text="{Binding DiskText}" Foreground="White" FontSize="12"/>
                                            <ProgressBar Height="6" Maximum="100" Value="{Binding DiskValue}" Foreground="{Binding DiskColor}" Background="#274753" Margin="0,5,0,12"/>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding NetworkText}" Foreground="#BBD1D6" FontSize="12" TextWrapping="Wrap"/>
                                                <TextBlock Grid.Column="1" Text="{Binding LoadText}" Foreground="#BBD1D6" FontSize="12" TextAlignment="Right"/>
                                            </Grid>
                                            <TextBlock Text="{Binding UptimeText}" Foreground="#9DB8C0" FontSize="12"/>
                                            <TextBlock Text="{Binding ServicesText}" Foreground="#9DB8C0" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding ServiceDetailText}" Foreground="#AFC6C9" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                            <Border Background="#421D3038" BorderBrush="#3F79DDBA" BorderThickness="1" CornerRadius="7" Padding="10,7" Margin="0,9,0,0">
                                                <TextBlock Text="{Binding HealthEventText}" Foreground="#D5E6DF" FontSize="11" TextWrapping="Wrap"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border x:Name="ServerAlertBanner" Background="{StaticResource WarningSurface}" BorderBrush="#88D8B76A" BorderThickness="1" CornerRadius="9" Padding="15" Margin="0,0,6,12">
                            <TextBlock x:Name="ServerAlertText" Text="尚未采样，不能判断是否存在告警。" Foreground="#F1D7A2" FontSize="13" TextWrapping="Wrap"/>
                        </Border>

                        <Border Background="#6810262E" BorderBrush="#588EAA9F" BorderThickness="1" CornerRadius="11" Padding="18" Margin="0,0,6,12">
                            <StackPanel>
                                <TextBlock Text="公开入口保护" Foreground="#9FC2C8" FontSize="12"/>
                                <TextBlock x:Name="PublicEntryTitle" Text="尚未体检" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,8,0,0"/>
                                <TextBlock x:Name="PublicEntryDetail" Text="等待公开入口探测" Foreground="#B9D2D8" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                <TextBlock x:Name="ServerCheckedAt" Text="还没有读取服务器；旧数据不会标成实时" Foreground="#8EAAB0" FontSize="11" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#7410262E" BorderBrush="#69C99747" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,6,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="实时信息流" Style="{StaticResource CloudTitleText}" FontSize="18"/>
                                        <TextBlock Text="这里只记录总管家实际读到的服务器样本，不拿旧配置冒充在线状态。" Foreground="#B9D2D8" FontSize="11" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="ServerStreamMeta" Grid.Column="1" Text="等待第一批真实样本" Foreground="#91B8BE" FontSize="11" VerticalAlignment="Bottom"/>
                                </Grid>
                                <ItemsControl x:Name="ServerEventStreamList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding TimeText}" Foreground="#88A9B0" FontFamily="{StaticResource CodeFont}" FontSize="11" Margin="0,4,10,0"/>
                                                <Border Grid.Column="1" Background="{Binding Accent}" CornerRadius="2"/>
                                                <StackPanel Grid.Column="2" Margin="13,0,0,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Source}" Foreground="#D7BE7C" FontSize="11" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Title}" Foreground="White" FontSize="12" FontWeight="SemiBold" Margin="12,0,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Detail}" Foreground="#AFC6C9" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border x:Name="ServerResultBanner" Background="{StaticResource InfoSurface}" BorderBrush="#5279B6A8" BorderThickness="1" CornerRadius="9" Padding="15" Margin="0,0,6,0">
                            <TextBlock x:Name="ServerResultText" Text="进入本页后会自动开始只读采样。" Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="3" Background="#42071418" BorderBrush="#26C99747" BorderThickness="0,1,0,0" Padding="30,10">
                <TextBlock x:Name="FooterMessage" Text="准备就绪" Foreground="#AFC6C9" FontSize="11"/>
            </Border>
        </Grid>
    </Grid>
</Window>
